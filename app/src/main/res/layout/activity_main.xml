<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/infinity_bg">
  <LinearLayout android:id="@+id/mainContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_infinity" android:contentDescription="Logo Infinity"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Infinity" android:textColor="@color/infinity_text" android:textSize="20sp" android:textStyle="bold"/>
            <TextView android:id="@+id/statusText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Votre assistant IA" android:textColor="@color/infinity_muted" android:textSize="12sp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/historyButton" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_button_secondary" android:src="@android:drawable/ic_menu_recent_history" android:tint="@color/infinity_text" android:contentDescription="Historique"/>
        <Space android:layout_width="8dp" android:layout_height="1dp"/>
        <ImageButton android:id="@+id/menuButton" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_button_secondary" android:src="@android:drawable/ic_menu_preferences" android:tint="@color/infinity_text" android:contentDescription="Menu"/>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#202A3B"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/chatContainer" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="14dp" android:paddingBottom="12dp"/>
        <LinearLayout android:id="@+id/welcomePanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="22dp">
            <ImageView android:layout_width="74dp" android:layout_height="74dp" android:src="@drawable/ic_infinity" android:contentDescription="Infinity"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/welcome_title" android:textColor="@color/infinity_text" android:textSize="24sp" android:textStyle="bold" android:gravity="center"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/welcome_subtitle" android:textColor="@color/infinity_muted" android:textSize="15sp" android:gravity="center"/>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/searchStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="4dp" android:paddingBottom="8dp" android:text="Recherche web en cours…" android:textColor="@color/infinity_blue" android:textSize="13sp" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:paddingTop="8dp" android:paddingBottom="12dp">
        <EditText android:id="@+id/messageInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="54dp" android:maxLines="5" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:hint="@string/input_hint" android:textColor="@color/infinity_text" android:textColorHint="#7F8BA3" android:textSize="16sp" android:background="@drawable/bg_input" android:inputType="textCapSentences|textMultiLine"/>
        <Space android:layout_width="9dp" android:layout_height="1dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/sendButton" android:layout_width="wrap_content" android:layout_height="54dp" android:minWidth="76dp" android:text="@string/send" android:textColor="#08101F" android:background="@drawable/bg_button_primary" android:insetTop="0dp" android:insetBottom="0dp" android:paddingStart="16dp" android:paddingEnd="16dp"/>
    </LinearLayout>
</LinearLayout>
  <View android:id="@+id/sidebarScrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000" android:visibility="gone" />
  <LinearLayout android:id="@+id/sidebarPanel" android:layout_width="300dp" android:layout_height="match_parent" android:layout_gravity="start" android:orientation="vertical" android:padding="16dp" android:background="@color/infinity_surface" android:elevation="12dp" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Historique" android:textColor="@color/infinity_text" android:textSize="22sp" android:textStyle="bold" />
      <ImageButton android:id="@+id/closeSidebarButton" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_button_secondary" android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="@color/infinity_text" android:contentDescription="Fermer le menu" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/newChatButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="+ Nouvelle conversation" android:textColor="#08101F" android:backgroundTint="@color/infinity_blue" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:layout_marginTop="12dp">
      <LinearLayout android:id="@+id/sidebarItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:text="Les conversations sont enregistrées sur cet appareil." android:textColor="@color/infinity_muted" android:textSize="12sp" />
  </LinearLayout>
</FrameLayout>
